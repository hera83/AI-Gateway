{
  "Api": {
    "Name": "AI Gateway"
  },
  "ConnectionStrings": {
    "Default": "Data Source=app_dbs/app.db",
    "Vectors": "Data Source=app_dbs/vectors.db"
  },
  "ApiKeys": {
    "MasterKey": ""
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "TimeoutMinutes": 15
  },
  "Speaches": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutMinutes": 75
  },
  "KnowledgeBase": {
    "EmbeddingModel": "nomic-embed-text",
    "EmbeddingDimensions": 768,
    "ChunkSizeCharacters": 1000,
    "ChunkOverlapCharacters": 150,
    "MaxUploadSizeBytes": 20971520,
    "DefaultTopK": 5
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 300000000
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
