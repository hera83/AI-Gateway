{
  "Api": {
    "Name": "AI Gateway"
  },
  "ConnectionStrings": {
    "Default": "Data Source=app_dbs/app.db",
    "Vectors": "Data Source=app_dbs/vectors.db"
  },
  "ApiKeys": {
    "MasterKey": ""
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "TimeoutMinutes": 15
  },
  "Speaches": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutMinutes": 75
  },
  "KnowledgeBase": {
    "EmbeddingModel": "nomic-embed-text",
    "EmbeddingDimensions": 768,
    "ChunkSizeCharacters": 1000,
    "ChunkOverlapCharacters": 150,
    "MaxUploadSizeBytes": 262144000,
    "DefaultTopK": 5,
    "WorkerIntervalSeconds": 60,
    "Ocr": {
      "Enabled": true,
      "Languages": "dan+eng",
      "RenderDpi": 300,
      "MinConfidence": 70,
      "MinWordConfidence": 50,
      "MinLineConfidence": 60,
      "MinKeptPercent": 60,
      "MinCharacters": 20,
      "MaxParallelism": 0
    },
    "Markdown": {
      "LlmModel": "qwen2.5:14b-instruct",
      "LlmMinOcrShare": 0.5,
      "LlmChunkCharacters": 3000,
      "LlmMinWordCoverage": 0.95
    },
    "Agent": {
      "MaxSearchRounds": 2,
      "QueriesPerRound": 4,
      "ResultsPerQuery": 5,
      "MaxSources": 12
    }
  },
  "Tesseract": {
    "ExecutablePath": "tesseract",
    "TessdataPath": "services/Tesseract/Tessdata",
    "TimeoutSeconds": 120
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 300000000
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
