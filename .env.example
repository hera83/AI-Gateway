# Kopiér denne fil til .env og udfyld værdierne, før du kører `docker compose up --build`.
# .env må aldrig committes. Nøglerne bruger .NET's __-notation (ApiKeys__MasterKey = ApiKeys:MasterKey).

# Master-nøglen til hele API'et (admin-endpoints). Tom = slået fra. Generér fx med: openssl rand -hex 32
ApiKeys__MasterKey=

# Ollama og Speaches. host.docker.internal peger på Docker-værten selv.
Ollama__BaseUrl=http://host.docker.internal:11434
Speaches__BaseUrl=http://host.docker.internal:8000
